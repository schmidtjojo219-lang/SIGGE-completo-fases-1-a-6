# ============================================
# SIGGE - Variáveis de Ambiente
# ============================================

# Banco de Dados (PostgreSQL)
# Local: postgresql://sigge:sigge_dev_password@localhost:5432/sigge
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL="postgresql://sigge:sigge_dev_password@localhost:5432/sigge"

# Redis (Cache/Sessões)
# Local: redis://localhost:6379
# Upstash: rediss://default:[password]@[host]:[port]
REDIS_URL="redis://localhost:6379"

# JWT Secrets (MUDE EM PRODUÇÃO!)
JWT_SECRET="sigge-super-secret-key-change-in-production-min-32-chars"
REFRESH_SECRET="sigge-refresh-secret-key-change-in-production-min-32-chars"

# AWS S3 (Armazenamento de arquivos)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="sigge-uploads"

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@sigge.app"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
